#
# md_indexer cloud LLM providers (format of ai_txt-system's private.env).
# Copy to ~/.config/md-indexer/.env (or pass -env-file / MD_AI_ENV_FILE), fill in your keys,
# and restrict it: chmod 600 ~/.config/md-indexer/.env
#
# Per provider:
#   <PROVIDER>_API_KEY   key; empty, missing or "none" disables the provider
#   <PROVIDER>_ENDPOINT  optional; the defaults below are used when unset
#   <PROVIDER>_LLM_01..  models offered in the desktop app / accepted by md-ai --provider
#
# The model IDs below are examples; check each provider's current model catalogue.
# Values in the process environment override this file. Retrieval and embeddings always stay
# local; only the answer is generated by the selected cloud model, from redacted vault excerpts.

# --- Ollama Cloud (https://ollama.com, model names without "-cloud" suffix) ---
OLLAMA_API_KEY=none
# OLLAMA_ENDPOINT=https://ollama.com
OLLAMA_LLM_01=gpt-oss:120b

# --- OpenRouter (OpenAI-compatible) ---
OPENROUTER_API_KEY=none
# OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1
OPENROUTER_LLM_01=deepseek/deepseek-r1:free

# --- NVIDIA NIM (OpenAI-compatible) ---
NVIDIA_API_KEY=none
# NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_01=meta/llama-3.3-70b-instruct

# --- Claude (Anthropic Messages API via the official Go SDK) ---
CLAUDE_API_KEY=none
CLAUDE_LLM_01=claude-opus-5-5
CLAUDE_LLM_02=claude-sonnet-5-5
CLAUDE_LLM_03=claude-haiku-5-5

# --- Gemini (Google's OpenAI-compatible endpoint) ---
GEMINI_API_KEY=none
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_LLM_01=gemini-3.8-flash
